<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        android:elevation="10dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:minHeight="?actionBarSize"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingEnd="16dp"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/appbar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            tools:context=".ui.login.LoginActivity">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Password saat ini"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_passive"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tf_password_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:foregroundTint="@color/text_passive"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/text_passive">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_password_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:hint="Password saat ini"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:singleLine="true"
                    android:foregroundTint="@color/text_passive"
                    android:textColor="@color/text_passive"
                    android:textColorHint="@color/text_passive"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Password baru"
                android:textSize="14sp"
                android:layout_marginTop="32dp"
                android:textColor="@color/text_passive"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tf_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foregroundTint="@color/text_passive"
                android:layout_marginTop="8dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/text_passive">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:hint="Password Baru"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:singleLine="true"
                    android:foregroundTint="@color/text_passive"
                    android:textColor="@color/text_passive"
                    android:textColorHint="@color/text_passive"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Ulangi password baru"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_passive"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tf_repassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foregroundTint="@color/text_passive"
                android:layout_marginTop="8dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/text_passive">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edt_repassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:hint="Ulangi Password Baru"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:foregroundTint="@color/text_passive"
                    android:textColor="@color/text_passive"
                    android:textColorHint="@color/text_passive"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp"
                    android:textSize="18sp"/>
            </com.google.android.material.textfield.TextInputLayout>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UBAH"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="32dp"
                android:padding="8dp"
                android:textSize="20sp"
                android:background="@drawable/bg_button"
                style="@style/Widget.AppCompat.Button.Borderless"/>

        </LinearLayout>
    </ScrollView>
    
</RelativeLayout>